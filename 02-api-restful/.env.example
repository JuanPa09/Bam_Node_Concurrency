# Copia este archivo a .env y completa los valores. .env NO se sube al repo.

NODE_ENV=development
PORT=3000

# Supabase -> botón "Connect" -> Session pooler (puerto 5432, compatible con IPv4)
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_POOL_MAX=5

# Opcional: certificado CA de Supabase (Project Settings -> Database -> SSL)
# para verificar TLS por completo. Ej: ./certs/prod-ca-2021.crt
DATABASE_CA_CERT=

# Secreto para la huella HMAC de las tarjetas (mínimo 32 caracteres).
# Genera uno con: openssl rand -hex 32
CARD_FINGERPRINT_SECRET=
